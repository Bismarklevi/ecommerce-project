# Copy this file to `.env` in the same directory and fill in real values.
# Never commit the real `.env` -- it holds live credentials.

SECRET_KEY=replace-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Production security headers ---
# These only take effect when DEBUG=False (local dev over http is unaffected).
# The defaults below are the secure production values and normally need no
# change; they're exposed here for hosts that terminate TLS unusually. With
# DEBUG=False the app also refuses to boot on the insecure default SECRET_KEY.
# SECURE_SSL_REDIRECT=True              # redirect http -> https
# SECURE_HSTS_SECONDS=31536000          # 1 year; set 0 only while first testing TLS
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True

DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=ecommerce
DATABASE_USER=ecommerce_user
DATABASE_PASSWORD=replace-me
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432

# --- Cloudflare R2 (image storage) ---
# Set USE_CLOUDFLARE_R2=false to store uploads on local disk instead (fine for
# local dev). When true, every ImageField save -- category tiles, product
# photos, banners -- is written straight to this bucket.
USE_CLOUDFLARE_R2=false
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_ENDPOINT_URL=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_REGION_NAME=auto
# Set this to your R2 bucket's public custom domain (or r2.dev subdomain) once
# you've enabled public access in the Cloudflare dashboard -- otherwise saved
# image URLs will point at the (private-by-default) S3 API endpoint and 403
# in the browser even though the upload itself succeeded.
CLOUDFLARE_R2_CUSTOM_DOMAIN=
CLOUDFLARE_R2_LOCATION=

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Paystack (payments) ---
# Test-mode keys from https://dashboard.paystack.com/#/settings/developer work
# fine for development; switch to live keys only in production.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Used to build the Paystack callback_url the customer lands on after paying
# (`${FRONTEND_URL}/checkout/success?order_id=...`). Point this at wherever the
# Next.js app is actually served.
FRONTEND_URL=http://localhost:3000

# --- Stock photography (seeding real category/product images) ---
# Only needed to run `python manage.py seed_womens_catalog`. Leave blank and
# the command still runs, it just skips fetching images. See
# backend/app/stock_photos.py for how to get either key (both free, ~2 min):
#   Unsplash: https://unsplash.com/developers
#   Pexels:   https://www.pexels.com/api/
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# --- Observability ---
# Leave SENTRY_DSN blank to disable error tracking entirely (fine for local dev).
# Set it in staging/production to receive error alerts.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO

# --- Email (password reset, order emails) ---
# Defaults to printing emails to the console -- fine for local dev, nothing to
# configure. In staging/production, point this at Resend/SendGrid/any SMTP
# provider's SMTP relay.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Kaira <no-reply@kaira.example.com>
