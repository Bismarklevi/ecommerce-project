# Copy this file to `.env` (or `.env.local`) and adjust for your environment.

# Base URL of the Django backend API this app talks to.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Public URL of this site, used for canonical metadata, robots.txt, and the
# sitemap. Set to the real domain in production (e.g. https://kaira.com).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Only needed once the backend has USE_CLOUDFLARE_R2=true AND
# CLOUDFLARE_R2_CUSTOM_DOMAIN set. Set this to that same hostname, no protocol.
# Leave blank while using local disk storage (the default).
NEXT_PUBLIC_MEDIA_HOST=

# Google sign-in button on /login. Leave blank to hide the button entirely.
# Must be the same OAuth client ID the backend has in GOOGLE_CLIENT_ID.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
