# Copy this file to `.env` (or `.env.local`) and adjust for your environment.

# Base URL of the Django backend API this app talks to.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Only needed once the backend has USE_CLOUDFLARE_R2=true AND
# CLOUDFLARE_R2_CUSTOM_DOMAIN set. Set this to that same hostname, no protocol.
# Leave blank while using local disk storage (the default).
NEXT_PUBLIC_MEDIA_HOST=
